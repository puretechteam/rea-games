{
  "name": "rea-games",
  "version": "1.0.0",
  "description": "Reverse-engineer any game: record the original's behavior, rebuild it in any engine, and prove the rebuild plays the same, frame by frame.",
  "keywords": [
    "game",
    "reverse-engineering",
    "clean-room",
    "port",
    "godot",
    "rust",
    "web",
    "claude-code",
    "agent-skill",
    "verification"
  ],
  "homepage": "https://github.com/erkamyaman/rea-games#readme",
  "bugs": {
    "url": "https://github.com/erkamyaman/rea-games/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkamyaman/rea-games.git"
  },
  "author": "Erkam Yaman (https://github.com/erkamyaman)",
  "funding": "https://github.com/sponsors/erkamyaman",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rea-games": "bin/rea-games.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "games/",
    "originals/",
    "skills/",
    ".claude-plugin/",
    "NOTICE",
    "DECISIONS.md",
    "!games/*/ports/rust/target/",
    "!games/*/ports/**/node_modules/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "node bin/rea-games.mjs verify all",
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
